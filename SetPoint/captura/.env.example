# =============================================================================
# Configuração do serviço de captura (copie para ".env" e ajuste)
#   cp .env.example .env
# =============================================================================

# Uma cópia deste serviço (com seu próprio .env) por câmera/quadra.
# A quadra é identificada no SetPoint pelo REPLAY_TOKEN (gerado em Quadras → Editar).

# --- Identificação ------------------------------------------------------------
# Apelido usado só nos nomes dos arquivos locais e no log.
QUADRA_ID=quadra-01

# --- Fonte de vídeo -----------------------------------------------------------
# FONTE=rtsp   -> usa a câmera IP (RTSP_URL abaixo)
# FONTE=teste  -> gera um vídeo sintético com o próprio FFmpeg (não precisa de
#                 câmera). Útil para validar todo o fluxo em laboratório.
FONTE=rtsp

# URL RTSP da câmera (a única instalada hoje: 192.168.1.10).
# >>> Troque SUA_SENHA pela senha da câmera. A senha NÃO fica neste arquivo, porque ele
# >>> vai para o GitHub: ela fica só no captura/.env, que o Git ignora.
# >>> O caminho /cam1/onvif-h264 varia por fabricante/modelo (testado no VLC).
RTSP_URL=rtsp://admin:SUA_SENHA@192.168.1.10:554/cam1/onvif-h264

# Incluir áudio no replay? Muitas câmeras IP mandam áudio G.711, que não cabe
# em .mp4 sem reencodar. Deixe "false" até testar com a câmera.
INCLUIR_AUDIO=false

# --- Buffer circular ----------------------------------------------------------
# Quantos segundos o replay deve ter (janela "últimos N segundos").
DURACAO_REPLAY_SEGUNDOS=30
# Tamanho de cada fragmento do buffer. Com "-c copy" o corte só acontece em
# keyframes, então o tamanho real depende do GOP configurado na câmera.
DURACAO_SEGMENTO_SEGUNDOS=2
# Ignora novos cliques que chegarem antes desse intervalo (anti-repique).
INTERVALO_MINIMO_ENTRE_CLIQUES=3

# --- Pastas -------------------------------------------------------------------
PASTA_BUFFER=./dados/buffer
PASTA_SAIDA=./dados/replays
# Manter uma cópia local do .mp4 depois de enviado? (fica em replays/enviados)
MANTER_COPIA_LOCAL=true

# --- Gatilho via HTTP (usado pelo SetPoint / botão "Salvar replay") ----------
# No SetPoint, o "Endereço do serviço de captura" da quadra é http://GATILHO_HOST:GATILHO_PORTA
# Mais de uma câmera no mesmo PC: use uma porta diferente para cada (8765, 8766...).
GATILHO_HOST=127.0.0.1
GATILHO_PORTA=8765

# --- Botoeira física (placa Zero Delay) ---------------------------------------
# BOTOEIRA_MODO:
#   desativado -> só aceita o gatilho via site (fase atual, sem a placa)
#   joystick   -> placa Zero Delay em modo gamepad (padrão da maioria)
#   teclado    -> placa em modo teclado (ou para testar com o teclado do PC)
#   terminal   -> aperte ENTER no terminal para simular a botoeira
BOTOEIRA_MODO=desativado
# Modo joystick: índice do botão na placa (descubra com: python testar_botoeira.py)
BOTOEIRA_JOYSTICK_BOTAO=0
# Modo teclado: tecla que dispara (ex.: space, enter, f9, ou uma letra como r)
BOTOEIRA_TECLA=space

# --- SetPoint (back-end Laravel) ----------------------------------------------
# Endpoint que recebe o .mp4 (POST multipart).
PORTAL_URL_UPLOAD=http://127.0.0.1:8000/api/replays/upload
# Token da câmera: no SetPoint, Quadras → Editar → Câmera de replay → Gerar token.
REPLAY_TOKEN=cole-aqui-o-token-gerado-no-setpoint

# --- FFmpeg -------------------------------------------------------------------
# Caminho do binário. Se vazio, usa o "ffmpeg" do PATH ou o do pacote
# imageio-ffmpeg (instalado pelo requirements.txt) como alternativa.
FFMPEG_BIN=
